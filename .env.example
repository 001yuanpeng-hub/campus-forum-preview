# 服务监听配置
HOST=0.0.0.0
PORT=3000

# 初始管理员账号（首次启动自动创建；上线前请务必修改密码）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-deploy
ADMIN_NICKNAME=站长

# 部署在 HTTPS 域名后设为 1（启用 Secure Cookie）
COOKIE_SECURE=0

# ===== 邮箱验证码发信配置（任选其一，配置后自动开启邮箱验证码与找回密码）=====
# 方式 A：QQ / 163 / 阿里云邮件推送 SMTPS（端口 465）
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=你的邮箱@qq.com
# SMTP_PASS=你的16位SMTP授权码
# MAIL_FROM=重电校园站 <你的邮箱@qq.com>

# 方式 B：Resend API（使用自定义域名发 noreply@cquet.top，免费每月 3000 封）
# RESEND_API_KEY=re_xxxxxxxxx
# MAIL_FROM=重电校园站 <noreply@cquet.top>
